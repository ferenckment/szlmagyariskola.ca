---
import Base from '../../../layouts/Base.astro';

const helpers = [
  'Madár Emőke',
  'Huiné dr. Ungár Júlia',
  'Kalmár Ágnes',
  'Kalmár László',
  'Kment Ferenc',
  'Kovács Szilvia',
  'Molnár László',
  'Sheila Vizi Virág',
  'Ungár Judit',
];
---

<Base title="Segítőink" description="A Szent László Magyar Iskola önkéntes segítői.">
  <div class="container container--narrow prose">
    <h1 class="page-title">Segítőink</h1>

    <p>Segítőink a 2025/26-os tanévben:</p>

    <ul style="columns: 2; column-gap: 3rem;">
      {helpers.map((name) => <li>{name}</li>)}
    </ul>

    <p><strong>Nagyon szépen köszönjük segítőink önzetlen munkáját!</strong></p>
  </div>
</Base>
